<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Newtonsoft.Json support for Samhammer.AspNetCore.StringTrimming: trims leading and trailing whitespace of all string inputs of ASP.NET Core MVC.</Description>
    <PackageTags>aspnetcore;mvc;trim;string;whitespace;model-binding;newtonsoft.json</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Samhammer.AspNetCore.StringTrimming\Samhammer.AspNetCore.StringTrimming.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
